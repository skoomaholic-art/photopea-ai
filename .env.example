# Poster Editor / Cloudflare Worker
# Copy values to Cloudflare Worker secrets / vars. Do not commit real secrets.

# Image sources
TMDB_ACCESS_TOKEN=
TMDB_API_KEY=
TMDB_COMMERCIAL_APPROVED=false
FANART_API_KEY=
FANART_CLIENT_KEY=

# AI via OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=https://skoomaholic-art.github.io/photopea-ai/
OPENROUTER_APP_TITLE=Poster Editor
OPENROUTER_OPENAI_IMAGE_MODEL=openai/gpt-image-1
OPENROUTER_XAI_IMAGE_MODEL=x-ai/grok-imagine-image-2.0

# Background removal
CARVE_API_KEY=
REMOVAL_AI_KEY=

# Optional CORS allowlist, comma-separated
ALLOWED_ORIGINS=https://skoomaholic-art.github.io
