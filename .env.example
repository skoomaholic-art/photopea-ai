# Server-only secrets. Never paste these into HTML/JavaScript or commit .env.
TMDB_READ_ACCESS_TOKEN=
TMDB_API_KEY=
XAI_API_KEY=
OPENAI_API_KEY=
# Billable generation stays off until explicitly enabled by the operator.
AI_REQUESTS_ENABLED=false
XAI_IMAGE_MODEL=grok-imagine-image-2.0
OPENAI_IMAGE_MODEL=gpt-image-2
API_TIMEOUT_MS=90000
# Password required when enabling paid AI on a non-loopback host.
# Any Basic Auth username; put a strong password here. Use HTTPS in production.
APP_ACCESS_PASSWORD=
# Optional exact origins, comma-separated; no trailing slash and no wildcard.
# Leave empty when the frontend and API share one origin.
ALLOWED_ORIGINS=
# Unified sources. Set approval only if your use is covered by the provider terms.
TMDB_ACCESS_TOKEN=
TMDB_COMMERCIAL_APPROVED=false
FANART_API_KEY=
FANART_CLIENT_KEY=
FANART_COMMERCIAL_APPROVED=false
# Optional Cloudflare Worker deployment; Node uses the direct keys above.
OPENROUTER_API_KEY=
OPENROUTER_OPENAI_IMAGE_MODEL=openai/gpt-image-1
OPENROUTER_XAI_IMAGE_MODEL=x-ai/grok-imagine-image-2.0
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-2-klein-4b
# Browser-local removal is the default. Remote removal is opt-in on the Worker only.
REMOTE_BACKGROUND_ENABLED=false
CARVE_API_KEY=
REMOVAL_AI_KEY=
